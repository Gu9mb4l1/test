local function revealActiveTab()
    task.defer(function()
        if not alive or not tabScroll.Parent then return end
        local entry = navButtons[activeSection]
        if not entry then return end
        local button = entry.button
        local left = button.AbsolutePosition.X - tabScroll.AbsolutePosition.X + tabScroll.CanvasPosition.X
        local right = left + button.AbsoluteSize.X
        local viewLeft = tabScroll.CanvasPosition.X
        local viewRight = viewLeft + tabScroll.AbsoluteSize.X
        if left < viewLeft then
            tabScroll.CanvasPosition = Vector2.new(math.max(0,left-4),0)
        elseif right > viewRight then
            tabScroll.CanvasPosition = Vector2.new(math.max(0,right-tabScroll.AbsoluteSize.X+4),0)
        end
    end)
end

local function sectionModules()
    local result = {}
    local query = string.lower(searchBox.Text)
    for _,module in ipairs(modules) do
        if module.section == activeSection then
            local haystack = string.lower(module.title .. " " .. module.summary)
            if query == "" or string.find(haystack, query, 1, true) then
                table.insert(result, module)
            end
        end
    end
    return result
end

