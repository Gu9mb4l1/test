local tabButtons = {}
local function clearPage()
    for _, connection in ipairs(pageConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(pageConnections)
    if pageCleanup then
        pcall(pageCleanup)
        pageCleanup = nil
    end
    for _, child in ipairs(content:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end
end

local function unload()
    if not alive then return end
    alive = false
    clearPage()
    for _, callback in ipairs(cleanupFunctions) do pcall(callback) end
    for _, connection in ipairs(categoryConnections) do pcall(function() connection:Disconnect() end) end
    for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
    table.clear(categoryConnections)
    table.clear(connections)
    table.clear(cleanupFunctions)
    if screenGui.Parent then screenGui:Destroy() end
    if type(environment.GumballMenu) == "table" and environment.GumballMenu.ScreenGui == screenGui then
        environment.GumballMenu = nil
    end
end

local function renderPage()
    clearPage()

    -- Always show the selected category in the content area, including Theme.
    textLabel(content, activeCategory, 22, Colors.White, {
        Name = "CurrentCategoryTitle",
        Position = UDim2.fromOffset(22, 13),
        Size = UDim2.new(1, -44, 0, 34),
