local function findViewmodelPart(part)
    if not part:IsA("BasePart") then return false end
    local camera=Workspace.CurrentCamera
    if not camera or not part:IsDescendantOf(camera) then return false end
    local par=part.Parent
    while par and par~=camera do
        local n=par.Name:lower()
        if n:find("viewmodel") or n:find("arms") or n:find("weapon") or n:find("gun") then return true end
        par=par.Parent
    end
    return false
end
local function updateViewmodel()
    local camera=Workspace.CurrentCamera
    if not camera then return end
    if not flag("View.Enabled") then
        for obj,props in pairs(originalProps) do
            if obj:IsA("BasePart") and (props.Material or props.Color or props.Transparency) and findViewmodelPart(obj) then
                for _,p in ipairs({"Material","Color","Transparency"}) do restoreProperty(obj,p) end
            end
        end
        return
    end
    local material=({Neon=Enum.Material.Neon,ForceField=Enum.Material.ForceField,
        SmoothPlastic=Enum.Material.SmoothPlastic,Glass=Enum.Material.Glass})[flag("View.Material")] or Enum.Material.Neon
    for _,part in ipairs(camera:GetDescendants()) do
        if findViewmodelPart(part) then
            local lname=part.Name:lower()
            if not flag("View.ExcludeArms") or not (lname:find("arm") or lname:find("hand")) then
                setRemembered(part,"Material",material)
                setRemembered(part,"Color",featureColor(flag("View.Color")))
                setRemembered(part,"Transparency",flag("View.Transparency"))
            end
        end
    end
end

local function updateCharacter()
    local char=userCharacter()
    local hum=userHumanoid()
    if not char or not hum then return end
    if activeHumanoid~=hum then
        activeHumanoid=hum
        originalWalk=hum.WalkSpeed
        originalJump=hum.JumpPower
        originalCameraOffset=hum.CameraOffset
    end
    if flag("Move.Speed") or flag("Move.Sprint") then
        setRemembered(hum,"WalkSpeed",flag("Move.Sprint") and mouseDown.Shift and flag("Move.SprintValue") or
            (flag("Move.Speed") and flag("Move.SpeedValue") or originalWalk or 16))
    else restoreProperty(hum,"WalkSpeed") end
    if flag("Move.Jump") then
        setRemembered(hum,"UseJumpPower",true)
        setRemembered(hum,"JumpPower",flag("Move.JumpValue"))
    else restoreProperty(hum,"JumpPower");restoreProperty(hum,"UseJumpPower") end
    if flag("Char.Offset") then setRemembered(hum,"CameraOffset",Vector3.new(0,flag("Char.OffsetY"),0))
    else restoreProperty(hum,"CameraOffset") end
    if flag("Char.Rotate") then
        local root=userRoot()
        local camera=Workspace.CurrentCamera
        if root and camera then
            local look=camera.CFrame.LookVector
            if Vector3.new(look.X,0,look.Z).Magnitude>.05 then
                root.CFrame=CFrame.lookAt(root.Position,root.Position+Vector3.new(look.X,0,look.Z))
            end
        end
    end
    for _,obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if flag("Move.Noclip") then setRemembered(obj,"CanCollide",false)
            else restoreProperty(obj,"CanCollide") end
            if flag("Char.Ghost") and obj.Name~="HumanoidRootPart" then
                setRemembered(obj,"LocalTransparencyModifier",flag("Char.Opacity"))
            else restoreProperty(obj,"LocalTransparencyModifier") end
        elseif obj:IsA("Accessory") then
            local handle=obj:FindFirstChild("Handle")
            if handle then
                if flag("Char.Accessories") then setRemembered(handle,"LocalTransparencyModifier",1)
                else restoreProperty(handle,"LocalTransparencyModifier") end
            end
        end
    end
    local camera=Workspace.CurrentCamera
    if camera then
        if flag("Move.FOV") then setRemembered(camera,"FieldOfView",flag("Move.FOVValue"))
        else restoreProperty(camera,"FieldOfView") end
    end
end

