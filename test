local function remember(obj,prop)
    if not obj or not obj.Parent then return end
    local rec=originalProps[obj]
    if not rec then rec={};originalProps[obj]=rec end
    if rec[prop]==nil then
        local ok,val=pcall(function() return obj[prop] end)
        if ok then rec[prop]=val end
    end
end
local function setRemembered(obj,prop,value)
    if not obj then return end
    remember(obj,prop)
    pcall(function() obj[prop]=value end)
end
local function restoreProperty(obj,prop)
    local rec=originalProps[obj]
    if rec and rec[prop]~=nil then
        pcall(function() obj[prop]=rec[prop] end)
        rec[prop]=nil
    end
end
local function restoreEverything()
    for obj,props in pairs(originalProps) do
        for prop,val in pairs(props) do
            pcall(function() obj[prop]=val end)
        end
        originalProps[obj]=nil
    end
end
