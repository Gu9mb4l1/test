local function drawPlayerESP()
    local root=userRoot()
    if not root or not (flag("ESP.Enabled") or flag("Cham.Enabled")) then clearESP();return end
    local allowed={}
    for _,p in ipairs(Players:GetPlayers()) do
        local enemy=isEnemy(p,flag("ESP.Team") and flag("Cham.Team"))
        if enemy then
            local head=hitPart(p,"Head")
            local distance=head and (head.Position-root.Position).Magnitude or math.huge
            local showLabel=flag("ESP.Enabled") and distance<=flag("ESP.Range") and (not flag("ESP.Team") or isEnemy(p,true))
            local showCham=flag("Cham.Enabled") and distance<=flag("Cham.Range") and (not flag("Cham.Team") or isEnemy(p,true))
            if showLabel or showCham then
                allowed[p]=true
                local entry=espObjects[p]
                if not entry or entry.character~=p.Character then
                    if entry then if entry.gui then entry.gui:Destroy() end;if entry.highlight then entry.highlight:Destroy() end end
                    entry={character=p.Character}
                    espObjects[p]=entry
                end
                if showLabel and head then
                    if not entry.gui then entry.gui,entry.label=makeBillboard("PlayerESP",head,160) end
                    entry.gui.Adornee=head
                    local hum=p.Character:FindFirstChildOfClass("Humanoid")
                    local info={}
                    if flag("ESP.Names") then table.insert(info,p.DisplayName) end
                    if flag("ESP.Distance") then table.insert(info,string.format("%dm",math.floor(distance+.5))) end
                    if flag("ESP.Health") and hum then table.insert(info,string.format("HP %d",math.floor(hum.Health+.5))) end
                    entry.label.Text=table.concat(info," | ")
                    entry.label.TextColor3=featureColor(flag("ESP.Color"))
                elseif entry.gui then entry.gui:Destroy();entry.gui=nil end
                if showCham then
                    if not entry.highlight then
                        entry.highlight=Instance.new("Highlight")
                        entry.highlight.Name="Gumball_Chams"
                        entry.highlight.Parent=p.Character
                    end
                    entry.highlight.Adornee=p.Character
                    entry.highlight.FillColor=featureColor(flag("Cham.Color"))
                    entry.highlight.OutlineColor=featureColor(flag("Cham.Color"))
                    entry.highlight.FillTransparency=flag("Cham.Fill")
                    entry.highlight.OutlineTransparency=flag("Cham.Outline")
                    entry.highlight.DepthMode=flag("Cham.Walls") and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
                elseif entry.highlight then entry.highlight:Destroy();entry.highlight=nil end
            end
        end
    end
    for p,entry in pairs(espObjects) do
        if not allowed[p] or not p.Parent then
            if entry.gui then pcall(function() entry.gui:Destroy() end) end
            if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
            espObjects[p]=nil
        end
    end
end
