-- Drag only from the title area. Tab/category clicks never drag the window.
local dragging = false
local dragInput = nil
local dragStart = nil
local startPosition = nil
connect(dragArea.InputBegan, function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    dragging = true
    dragInput = input
    dragStart = input.Position
    startPosition = window.Position
end)
connect(UserInputService.InputChanged, function(input)
    if not alive or not dragging or not dragStart or not startPosition then return end
    if dragInput and dragInput.UserInputType == Enum.UserInputType.Touch then
        if input ~= dragInput then return end
    elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end
    local delta = input.Position - dragStart
    window.Position = UDim2.new(
        startPosition.X.Scale, startPosition.X.Offset + delta.X,
        startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
    )
end)
connect(UserInputService.InputEnded, function(input)
    if input == dragInput or (dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
        dragging = false
        dragInput = nil
    end
end)

local cameraSizeConnection = nil
local function resizeForScreen()
    if not alive then return end
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
    local width = math.min(774, math.max(280, viewport.X - 18))
    local height = math.min(524, math.max(250, viewport.Y - 18))
    local narrow = width < 560
    local sidebarWidth = narrow and 120 or 135
    local headerTabsX = narrow and 125 or 150

    window.Size = UDim2.fromOffset(width, height)
    dragArea.Size = UDim2.fromOffset(headerTabsX - 1, 54)
    title.TextSize = narrow and 20 or 24
    title.Size = UDim2.fromOffset(headerTabsX - 19, 53)
    topScroll.Position = UDim2.fromOffset(headerTabsX, 0)
    topScroll.Size = UDim2.new(1, -headerTabsX - 6, 0, 54)

    -- Distribute extra width evenly, but preserve compact tabs on small screens.
    local available = width - headerTabsX - 6
    local totalBase = 0
    for _, tabName in ipairs(TabOrder) do
        totalBase = totalBase + tabButtons[tabName].BaseWidth
    end
    local extra = math.max(0, available - totalBase - (#TabOrder - 1) * 2)
    local eachExtra = math.floor(extra / #TabOrder)
    local remainder = extra - eachExtra * #TabOrder
    for index, tabName in ipairs(TabOrder) do
        local tab = tabButtons[tabName]
        local tabWidth = tab.BaseWidth + eachExtra + (index <= remainder and 1 or 0)
        tab.Button.Size = UDim2.fromOffset(tabWidth, 54)
    end

    sidebar.Size = UDim2.new(0, sidebarWidth, 1, -54)
    content.Position = UDim2.fromOffset(sidebarWidth + 1, 54)
    content.Size = UDim2.new(1, -sidebarWidth - 1, 1, -54)
    renderCategories()
end

local function bindCamera()
    if cameraSizeConnection then
        cameraSizeConnection:Disconnect()
        cameraSizeConnection = nil
    end
    if Workspace.CurrentCamera then
        cameraSizeConnection = connect(Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), resizeForScreen)
    end
    resizeForScreen()
end
connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
bindCamera()

