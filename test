        Get = function(key) return palette(key) end,
        Set = setThemeColor,
        Save = function(name) return saveTheme(name,true) end,
        Load = function(name) local ok,err=loadTheme(name);if ok then persistTheme();paintTheme() end;return ok,err end,
        List = themeList,
        Reset = function() themeValues=table.clone(themeDefaults);themeName="Default";paintTheme() end,
    },
    Config = {
        Capture = captureConfig,
        Apply = applyConfig,
        Save = function(name) return saveConfig(name,true) end,
        Load = loadConfig,
        Delete = deleteConfig,
        List = listConfigs,
        Export = exportConfig,
        Import = importConfig,
    },
    RegisterSetting = function(id,getter,setter)
        if not alive or type(id)~="string" or type(getter)~="function" or type(setter)~="function" then return false end
        registeredSettings[id]={get=getter,set=setter}
        if pendingAutoLoadValues and pendingAutoLoadValues[id]~=nil then
            cfgLoading=true
            local ok,err=pcall(setter,pendingAutoLoadValues[id])
            cfgLoading=false
            if not ok then warn("[Gumball Config] Late setting failed: "..tostring(err)) end
        end
        return true
    end,
    UnregisterSetting = function(id) registeredSettings[id]=nil end,
    SettingChanged = settingChanged,
    RegisterCleanup = function(callback)
        if alive and type(callback) == "function" then
            table.insert(cleanupFunctions, callback)
        end
    end,
    RegisterPage = function(tabName, categoryName, builder)
        if not alive or not Categories[tabName] or type(builder) ~= "function" then return false end
        local valid = false
        for _, name in ipairs(Categories[tabName]) do
            if name == categoryName then valid = true; break end
        end
        if not valid then return false end
        pageBuilders[tabName] = pageBuilders[tabName] or {}
        pageBuilders[tabName][categoryName] = builder
        if tabName == activeTab and categoryName == activeCategory then renderPage() end
        return true
    end,
}

