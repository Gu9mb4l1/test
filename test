    local state = moduleState(activeModule.id)
    local value = state[key]
    local selected = 1
    for index, option in ipairs(choices) do
        if option == value then selected=index; break end
    end
    state[key] = choices[selected]
    local button = textButton(frame, choices[selected] .. "  >", {
        Position=UDim2.fromOffset(14,60), Size=UDim2.new(1,-28,0,23),
        TextSize=13, BackgroundColor3=C.raised,
    })
    track(button.MouseButton1Click:Connect(function()
        selected = selected % #choices + 1
        state[key] = choices[selected]
        button.Text = choices[selected] .. "  >"
        if onChange then onChange(choices[selected]) end
        emit(activeModule.id, key, state[key])
    end), true)
    return frame
end
