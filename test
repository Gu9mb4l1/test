-- Call this after a registered feature setting changes. Multiple rapid changes
-- are coalesced into one write, avoiding a file write on every slider frame.
local function settingChanged()
    if not alive or cfgLoading or not cfgState.AutoSave or cfgState.AutoSaveProfile=="" then return end
    cfgRevision += 1
    local revision=cfgRevision
    task.delay(0.85,function()
        if not alive or cfgLoading or not cfgState.AutoSave or revision~=cfgRevision then return end
        local ok,err=saveConfig(cfgState.AutoSaveProfile,true)
        if not ok then warn("[Gumball Config] Auto Save failed: "..tostring(err)) end
    end)
end

local function unload()
    if not alive then return end
    alive = false
    if cfgState.AutoSave and cfgState.AutoSaveProfile~="" then
        local ok,err=saveConfig(cfgState.AutoSaveProfile,true)
        if not ok then warn("[Gumball Config] Auto Save failed: "..tostring(err)) end
    end
    clearPage()
    for _, callback in ipairs(cleanupFunctions) do pcall(callback) end
    for _, connection in ipairs(categoryConnections) do pcall(function() connection:Disconnect() end) end
    for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
    table.clear(categoryConnections)
    table.clear(connections)
    table.clear(cleanupFunctions)
    if screenGui.Parent then screenGui:Destroy() end
    if type(environment.GumballMenu) == "table" and environment.GumballMenu.ScreenGui == screenGui then
        environment.GumballMenu = nil
    end
end

