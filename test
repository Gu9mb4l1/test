renderInspector = function(module)
    disconnectInspector()
    clearObjects(inspectScroll)
    if not module then
        inspectTitle.Text="No module"
        inspectDetail.Text="Select a module from the library."
        return
    end
    activeModule = module
    inspectTitle.Text = module.title
    inspectDetail.Text = module.detail
    inspectScroll.CanvasPosition = Vector2.new(0,0)

    if module.id == "welcome" or module.id == "roadmap" then
        informationCard("Gumball Control Deck", "Compact top tabs, searchable feature library, and a dedicated settings inspector. No copied Kicia or UE interface.", 122)
        informationCard("What works now", "Navigation, search, module selection, demo toggles, demo sliders, appearance settings, drag, hide/show, and mobile navigation.", 122)
        informationCard("What comes next", "We will implement features one at a time. None of the preview controls modify Roblox gameplay yet.", 115)
        actionCard("Test the notification system", "SHOW TEST MESSAGE", function()
            notify("Gumball Control Deck is ready")
        end)
    elseif module.id == "appearance" then
        informationCard("Dark theme", "The interface uses a single graphite-and-white dark theme. There are no other theme presets.", 113)
