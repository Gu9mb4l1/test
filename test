local function soundESP()
    if not flag("Sound.Enabled") then clearSoundESP();return end
    local root=userRoot()
    if not root then clearSoundESP();return end
    local ranked={}
    for sound in pairs(sounds) do
        if sound.Parent and sound:IsDescendantOf(Workspace) and sound.IsPlaying then
            local adornee=getSoundAdornee(sound)
            if adornee then
                local pos=adornee:IsA("Attachment") and adornee.WorldPosition or adornee.Position
                local dist=(pos-root.Position).Magnitude
                if dist<=flag("Sound.Range") then table.insert(ranked,{sound=sound,adornee=adornee,distance=dist}) end
            end
        elseif not sound.Parent then sounds[sound]=nil end
    end
    table.sort(ranked,function(a,b) return a.distance<b.distance end)
    local retain={}
    for i=1,math.min(#ranked,math.floor(flag("Sound.Limit"))) do
        local r=ranked[i]
        retain[r.sound]=true
        local entry=soundLabels[r.sound]
        if not entry then
            local bb,text=makeBillboard("SoundESP",r.adornee,160)
            bb.StudsOffsetWorldSpace=Vector3.new(0,.65,0)
            entry={gui=bb,label=text}
            soundLabels[r.sound]=entry
        end
        entry.gui.Adornee=r.adornee
        local label=flag("Sound.Name") and r.sound.Name or "Playing sound"
        if flag("Sound.Distance") then label=label..string.format(" (%dm)",math.floor(r.distance)) end
        entry.label.Text=label
        entry.label.TextColor3=Color3.fromRGB(255,225,145)
    end
    for sound,entry in pairs(soundLabels) do
        if not retain[sound] then entry.gui:Destroy();soundLabels[sound]=nil end
    end
end

