local function make(className, parent, properties)
    local instance = Instance.new(className)
    for property, value in pairs(properties or {}) do
        instance[property] = value
    end
    instance.Parent = parent
    return instance
end
local function rounded(instance, radius)
    make("UICorner", instance, {CornerRadius=UDim.new(0, radius or 10)})
    return instance
end
local function stroked(instance, color, thickness)
    return make("UIStroke", instance, {Color=color or C.line, Thickness=thickness or 1})
end
local function label(parent, value, size, color, properties)
    local props = {
        BackgroundTransparency=1, Text=tostring(value or ""), Font=font,
        TextSize=size or 14, TextColor3=color or C.white,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Center,
        TextTruncate=Enum.TextTruncate.AtEnd,
        BorderSizePixel=0,
    }
    for k,v in pairs(properties or {}) do props[k]=v end
    return make("TextLabel", parent, props)
end
local function textButton(parent, value, properties)
    local props = {
        Text=tostring(value or ""), Font=font, TextSize=14,
        TextColor3=C.white, BackgroundColor3=C.tile,
        BorderSizePixel=0, AutoButtonColor=false,
    }
    for k,v in pairs(properties or {}) do props[k]=v end
    return rounded(make("TextButton", parent, props), 9)
end
local function line(parent, position, size)
    return make("Frame", parent, {BackgroundColor3=C.line, BorderSizePixel=0, Position=position, Size=size})
end
local function track(connection, dynamic)
    table.insert(dynamic and inspectorConnections or globalConnections, connection)
    return connection
end
local function disconnectBrowser()
    for _,connection in ipairs(browserConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(browserConnections)
end
local function disconnectInspector()
    for _,connection in ipairs(inspectorConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(inspectorConnections)
end
local function clearObjects(parent)
    for _,child in ipairs(parent:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end
end
local function markAccent(instance, property, enabled, offColor)
    if enabled then
        instance:SetAttribute("GumballAccentProperty", property)
        instance[property] = C.accent
    else
        instance:SetAttribute("GumballAccentProperty", nil)
        if offColor then instance[property] = offColor end
    end
end

