local function notify(message)
    if not alive or not screen.Parent then return end
    toastGeneration = toastGeneration + 1
    local generation = toastGeneration
    toast.Text = tostring(message)
    toast.Visible = true
    toast.TextTransparency = 0
    toast.BackgroundTransparency = 0
    task.delay(2.2, function()
        if not alive or generation ~= toastGeneration or not toast.Parent then return end
        local animation = TweenService:Create(toast, TweenInfo.new(.25), {
            TextTransparency=1, BackgroundTransparency=1,
        })
        animation:Play()
        animation.Completed:Wait()
        if alive and generation == toastGeneration then toast.Visible=false end
    end)
end
local function emit(id, key, value)
    for _,callback in ipairs(changeListeners) do
        local ok, err = pcall(callback, id, key, value)
        if not ok then warn("[Gumball UI] Callback error:", err) end
    end
end
local function moduleState(id)
    if not states[id] then
