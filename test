local function updateRecord(dt)
    local root=userRoot()
    if flag("Record.Active") and root then
        recordingClock += dt
        if recordingClock>=flag("Record.Sample") then
            recordingClock=0
            table.insert(route,root.Position)
            while #route>flag("Record.Max") do table.remove(route,1) end
        end
    end
    if flag("Record.Play") and #route>0 then
        if not routeGhost or not routeGhost.Parent then
            routeGhost=make("Part",Workspace,{Name="Gumball_RouteGhost",Size=Vector3.new(2,3,1),
                Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,
                Transparency=.4,Material=Enum.Material.Neon})
        end
        routeGhost.Color=featureColor(flag("Record.Color"))
        replayPos += dt/math.max(flag("Record.Sample"),0.1)*flag("Record.Speed")
        if replayPos>#route then replayPos=1 end
        routeGhost.Position=route[math.max(1,math.min(#route,math.floor(replayPos)))]
    elseif routeGhost then routeGhost:Destroy();routeGhost=nil end
end
