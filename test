    textLabel(content, activeTab .. "  /  " .. activeCategory, 13, Colors.Muted, {
        Name = "CurrentCategoryPath",
        Position = UDim2.fromOffset(23, 46),
        Size = UDim2.new(1, -46, 0, 21),
    })
    make("Frame", content, {
        Name = "CategoryHeadingDivider",
        Position = UDim2.fromOffset(22, 77),
        Size = UDim2.new(1, -44, 0, 1),
        BackgroundColor3 = Colors.Border,
        BorderSizePixel = 0,
    })

    -- Empty category pages remain empty below their heading for now.
    local pageBody = make("Frame", content, {
        Name = "CategorySettings",
        Position = UDim2.fromOffset(0, 86),
        Size = UDim2.new(1, 0, 1, -86),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    })

    -- Keep the requested functional unload button under Settings > General.
    if activeTab == "Settings" and activeCategory == "General" then
        local unloadButton = addCorner(make("TextButton", pageBody, {
            Name = "UnloadGumball",
            Position = UDim2.fromOffset(22, 14),
            Size = UDim2.fromOffset(165, 39),
            BackgroundColor3 = Color3.fromRGB(30, 17, 22),
            BorderSizePixel = 0,
            Text = "Unload Gumball",
            Font = Enum.Font.Cartoon,
            TextSize = 16,
            TextColor3 = Color3.fromRGB(241, 154, 154),
            AutoButtonColor = false,
        }), 7)
        make("UIStroke", unloadButton, {Color = Color3.fromRGB(97, 45, 54), Thickness = 1})
        connect(unloadButton.MouseButton1Click, unload, pageConnections)
    end

    local buildersForTab = pageBuilders[activeTab]
    local builder = buildersForTab and buildersForTab[activeCategory]
    if type(builder) == "function" then
        local ok, result = pcall(builder, pageBody)
        if ok and type(result) == "function" then
            pageCleanup = result
        elseif not ok then
            warn("[Gumball] Page error: " .. tostring(result))
        end
    end
end

local function refreshTabs()
    for tabName, data in pairs(tabButtons) do
        local selected = tabName == activeTab
        data.Text.TextColor3 = selected and Colors.White or Colors.Muted
        data.Underline.Visible = selected
    end
end

local function renderCategories()
    for _, connection in ipairs(categoryConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(categoryConnections)
    for _, child in ipairs(sidebarScroll:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end
    sidebarScroll.CanvasPosition = Vector2.new(0, 0)

    local usableWidth = math.max(80, sidebar.Size.X.Offset - 25)
    for index, category in ipairs(Categories[activeTab]) do
        local selected = category == activeCategory
        local textWidth = 0
        local measured = pcall(function()
            textWidth = TextService:GetTextSize(category, 16, Enum.Font.Cartoon, Vector2.new(500, 40)).X
        end)
        if not measured then textWidth = #category * 9 end
        local needsWrap = textWidth > usableWidth
        local rowHeight = needsWrap and 52 or 40

        local item = make("TextButton", sidebarScroll, {
            Name = "Category_" .. tostring(index),
            LayoutOrder = index,
            Size = UDim2.new(1, -4, 0, rowHeight),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
        })
        local nameLabel = textLabel(item, category, 16, selected and Colors.White or Colors.Muted, {
            Name = "CategoryName",
            Position = UDim2.fromOffset(13, 0),
            Size = UDim2.new(1, -22, 0, rowHeight - 8),
            TextWrapped = needsWrap,
            TextYAlignment = Enum.TextYAlignment.Center,
        })
        -- Horizontal underline BELOW the category name, never over its first letters.
        addCorner(make("Frame", item, {
            Name = "ActiveCategoryUnderline",
            Position = UDim2.fromOffset(13, rowHeight - 4),
            Size = UDim2.fromOffset(math.max(24, math.min(textWidth, usableWidth)), 2),
            BackgroundColor3 = Colors.White,
            BorderSizePixel = 0,
            Visible = selected,
        }), 2)

        connect(item.MouseEnter, function()
            if alive and category ~= activeCategory then nameLabel.TextColor3 = Colors.White end
        end, categoryConnections)
        connect(item.MouseLeave, function()
            if alive and category ~= activeCategory then nameLabel.TextColor3 = Colors.Muted end
        end, categoryConnections)
        connect(item.MouseButton1Click, function()
            if not alive or category == activeCategory then return end
            activeCategory = category
            renderCategories()
            renderPage()
        end, categoryConnections)
    end
end

local function selectTab(tabName)
    if not alive or not Categories[tabName] then return end
    activeTab = tabName
    activeCategory = Categories[tabName][1]
    refreshTabs()
    renderCategories()
    renderPage()
    task.defer(function()
        if not alive then return end
        local tab = tabButtons[tabName]
        if not tab then return end
        local left = tab.Button.AbsolutePosition.X - topScroll.AbsolutePosition.X
        local right = left + tab.Button.AbsoluteSize.X
        if left < 0 then
            topScroll.CanvasPosition = Vector2.new(math.max(0, topScroll.CanvasPosition.X + left), 0)
        elseif right > topScroll.AbsoluteSize.X then
            topScroll.CanvasPosition = Vector2.new(topScroll.CanvasPosition.X + right - topScroll.AbsoluteSize.X, 0)
        end
    end)
end

