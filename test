local function isEnemy(other,ignoreTeam)
    if other==localPlayer or not other.Character then return false end
    local hum=other.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return false end
    if ignoreTeam and not localPlayer.Neutral and not other.Neutral and localPlayer.Team~=nil and other.Team==localPlayer.Team then
        return false
    end
    return true
end
local function hitPart(other,partChoice)
    local char=other.Character
    return char and (char:FindFirstChild(partChoice=="Root" and "HumanoidRootPart" or "Head") or char:FindFirstChild("HumanoidRootPart"))
end
local function hasSight(part)
    local camera=Workspace.CurrentCamera
    if not camera or not part then return false end
    local origin=camera.CFrame.Position
    local difference=part.Position-origin
    local filter=RaycastParams.new()
    filter.FilterType=Enum.RaycastFilterType.Exclude
    filter.FilterDescendantsInstances={userCharacter()}
    filter.IgnoreWater=true
    local result=Workspace:Raycast(origin,difference,filter)
    return not result or result.Instance:IsDescendantOf(part.Parent)
end
local function getTarget(radius,range,partChoice,ignoreTeam,visibleOnly)
    local camera=Workspace.CurrentCamera
    local root=userRoot()
    if not camera or not root then return nil,nil end
    local center=camera.ViewportSize/2
    local closest=math.huge
    local winner,bestPart=nil,nil
    for _,other in ipairs(Players:GetPlayers()) do
        if isEnemy(other,ignoreTeam) then
            local part=hitPart(other,partChoice)
            if part and (part.Position-root.Position).Magnitude<=range then
                local p,onScreen=camera:WorldToViewportPoint(part.Position)
                if onScreen and p.Z>0 then
                    local dist=(Vector2.new(p.X,p.Y)-center).Magnitude
                    if dist<closest and dist<=radius and (not visibleOnly or hasSight(part)) then
                        winner,bestPart=other,part
                        closest=dist
                    end
                end
            end
        end
    end
    return winner,bestPart
end
