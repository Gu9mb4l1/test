local function updateWeapon()
    if flag("Weapon.Equip") then equipByName(flag("Weapon.Preferred")) end
    if flag("Weapon.Automatic") and (not flag("Weapon.Hold") or mouseDown.LMB) and os.clock()-repeatClock>=flag("Weapon.FireRate") then
        repeatClock=os.clock();fireTool()
    end
end
local function isRayTarget(part,team)
    if not part then return false end
    local model=part:FindFirstAncestorOfClass("Model")
    local hum=model and model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return false end
    local p=Players:GetPlayerFromCharacter(model)
    return p and isEnemy(p,team) or false
end
local function updateCombat()
    local camera=Workspace.CurrentCamera
    if not camera then return end
    local center=camera.ViewportSize/2
    aimCircle.Visible=flag("Aim.Enabled") and flag("Aim.Circle")
    if aimCircle.Visible then
        local diameter=flag("Aim.FOV")*2
        aimCircle.Position=UDim2.fromOffset(center.X,center.Y)
        aimCircle.Size=UDim2.fromOffset(diameter,diameter)
    end
    local canAim=flag("Aim.Enabled") and (flag("Aim.Mode")=="Always" or mouseDown.RMB)
    local canRage=flag("Rage.Enabled") and (not flag("Rage.Hold") or mouseDown.RMB)
    if canRage or canAim then
        local prefix=canRage and "Rage" or "Aim"
        local _,part=getTarget(canRage and 1200 or flag("Aim.FOV"),flag(prefix..".Range"),
            flag(prefix..".Part"),flag(prefix..".Team"),flag(prefix..".Walls"))
        if part then
            local lead=(canAim and flag("Aim.Prediction") or 0)
            local vel=part.AssemblyLinearVelocity
            local goal=CFrame.lookAt(camera.CFrame.Position,part.Position+vel*lead)
            camera.CFrame=camera.CFrame:Lerp(goal,flag(prefix..".Smooth"))
            if canRage and flag("Rage.Fire") and os.clock()-fireClock>=flag("Rage.Delay") then
                fireClock=os.clock();fireTool()
            end
        end
    end
    silentMarker.Visible=false
    if flag("Silent.Enabled") then
        local who,part=getTarget(flag("Silent.FOV"),flag("Silent.Range"),flag("Silent.Part"),flag("Silent.Team"),flag("Silent.Walls"))
        if part then
            local predicted=part.Position+part.AssemblyLinearVelocity*flag("Silent.Lead")
            local p,onScreen=camera:WorldToViewportPoint(predicted)
            if onScreen then
                silentMarker.Visible=true
                silentMarker.Position=UDim2.fromOffset(p.X-2,p.Y-2)
                silentMarker.BackgroundColor3=palette("Accent")
                silentMarker.Size=UDim2.fromOffset(7,7)
            end
        end
    end
    if flag("Trigger.Enabled") and (not flag("Trigger.Hold") or mouseDown.RMB) and
        os.clock()-fireClock>=flag("Trigger.Delay") then
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={userCharacter()}
        local ray=camera:ViewportPointToRay(center.X,center.Y)
        local result=Workspace:Raycast(ray.Origin,ray.Direction*flag("Trigger.Range"),params)
        if result and isRayTarget(result.Instance,flag("Trigger.Team")) then
            fireClock=os.clock()
            fireTool()
        end
    end
end

local function updateDetection()
    if not flag("Detect.Enabled") or not flag("Detect.Near") or os.clock()-detectClock<flag("Detect.Interval") then return end
    local root=userRoot()
    if not root then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if isEnemy(p,flag("Detect.Team")) then
            local pt=hitPart(p,"Root")
            if pt and (pt.Position-root.Position).Magnitude<flag("Detect.Range") then
                detectClock=os.clock()
                tell("Nearby player: "..p.DisplayName)
                break
            end
        end
    end
end

local function setFeature(key,value,notify)
    local spec=FeatureDefinitions[key]
    if not spec then return false end
    local kind=spec.kind
    if kind=="toggle" then value=not not value
    elseif kind=="slider" then
        if type(value)~="number" then return false end
        value=math.clamp(value,spec.min,spec.max)
        value=math.floor(value/spec.step+.5)*spec.step
        value=tonumber(string.format("%.3f",value))
    elseif kind=="choice" then
        if type(value)~="string" or not table.find(spec.choices,value) then return false end
    elseif kind=="text" then
        if type(value)~="string" then return false end
        value=value:sub(1,70)
    else return false end
    if FeatureValues[key]==value then return true end
    FeatureValues[key]=value
    local render=featureUpdaters[key]
    if render then pcall(render,value) end
    if key:sub(1,6)=="Effect" or key:sub(1,5)=="Light" or key:sub(1,4)=="Sky." then
        if key~="Sky.Rain" and key~="Sky.RainRate" then applyLighting() end
    end
    if key=="Record.Clear" then table.clear(route);replayPos=1 end
    if key=="Record.Play" then replayPos=1 end
    if key=="Match.Reset" then
        local hum=userHumanoid()
        if hum and Workspace.CurrentCamera then Workspace.CurrentCamera.CameraSubject=hum end
    end
    if key=="Load.Equip" then
        local slot=flag("Load.Slot")
        tell(equipByName(flag("Load."..slot)) and "Tool equipped" or "Tool not found in Backpack")
    end
    if notify then API.SettingChanged() end
    return true
end

local function resetFeature(key)
    if key=="Record.Clear" then
        table.clear(route);replayPos=1
        if routeGhost then routeGhost:Destroy();routeGhost=nil end
        tell("Route cleared")
    elseif key=="Load.Equip" then
        local slot=flag("Load.Slot")
        tell(equipByName(flag("Load."..slot)) and "Tool equipped" or "Tool not found")
    elseif key=="Match.Reset" then
        local hum=userHumanoid()
        if hum and Workspace.CurrentCamera then Workspace.CurrentCamera.CameraSubject=hum end
        tell("Camera restored")
    end
end

