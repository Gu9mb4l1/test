local globalRender=connect(RunService.RenderStepped,function(dt)
    if not featureAlive then return end
    dt=math.min(dt,0.15)
    secondsRunning+=dt
    frameCount+=1
    fpsClock+=dt
    espClock+=dt
    soundClock+=dt
    effectsClock+=dt
    hudClock+=dt
    if fpsClock>=1 then
        fps=math.floor(frameCount/fpsClock+.5)
        fpsClock=0;frameCount=0
    end
    -- Fast frame-sensitive work is gated behind toggles.
    if flag("Aim.Enabled") or flag("Rage.Enabled") or flag("Trigger.Enabled") or flag("Silent.Enabled") then
        updateCombat()
    else aimCircle.Visible=false;silentMarker.Visible=false end
    if flag("Move.Noclip") or flag("Char.Rotate") then updateCharacter() end
    if flag("Record.Active") or flag("Record.Play") then updateRecord(dt) end
    if effectsClock>=(flag("General.Performance") and .65 or .30) then
        effectsClock=0
        updateCharacter();updateGhost();updateRain();updateViewmodel();updateWeapon();updateCrosshair()
        applyLighting();updateDetection()
    end
    if espClock>=flag("ESP.Update") then
        espClock=0;drawPlayerESP()
    end
    if soundClock>=flag("Sound.Update") then
        soundClock=0;soundESP()
    end
    if hudClock>=.33 then hudClock=0;updateHUD(dt) end
end)

-- Restore camera after spectate is disabled, and follow nearest player when enabled.
local spectateClock=0
connect(RunService.Heartbeat,function(dt)
    if not featureAlive then return end
    spectateClock+=dt
    if spectateClock<.75 then return end
    spectateClock=0
    local camera=Workspace.CurrentCamera
    if not camera then return end
    if flag("Match.Spectate") then
        local root=userRoot()
        local winner,best=nil,math.huge
        if root then
            for _,p in ipairs(Players:GetPlayers()) do
                if p~=localPlayer and p.Character then
                    local target=p.Character:FindFirstChild("HumanoidRootPart")
                    local hum=p.Character:FindFirstChildOfClass("Humanoid")
                    if target and hum and hum.Health>0 then
                        local d=(root.Position-target.Position).Magnitude
                        if d<best and d<flag("Match.SpectateRange") then winner=hum;best=d end
                    end
                end
            end
        end
        if winner then setRemembered(camera,"CameraSubject",winner) end
    else restoreProperty(camera,"CameraSubject") end
end)


