renderInspector = function(module)
    disconnectInspector()
    clearObjects(inspectScroll)
    if not module then
        inspectTitle.Text="No module"
        inspectDetail.Text="Select a module from the library."
        return
    end
    activeModule = module
    inspectTitle.Text = module.title
    inspectDetail.Text = module.detail
    inspectScroll.CanvasPosition = Vector2.new(0,0)

    if module.section == "Home" then
        informationCard("A new layout", "A vertical section rail, searchable module library, and focused settings inspector. No copied Kicia or UE interface.", 122)
        informationCard("What works now", "Navigation, search, module selection, demo toggles, demo sliders, appearance settings, drag, hide/show, and mobile navigation.", 122)
        informationCard("What comes next", "We will implement features one at a time. None of the preview controls modify Roblox gameplay yet.", 115)
        actionCard("Test the notification system", "SHOW TEST MESSAGE", function()
            notify("Gumball Control Deck is ready")
        end)
    elseif module.id == "appearance" then
        choiceCard("Accent palette", "Choose the interface highlight color.", "theme", {"Amber","Mint","Rose"}, function(theme)
            updateAccent(accentPalettes[theme])
        end)
        toggleCard("Compact mode", "Reduce spacing between module tiles.", "compact")
        informationCard("Interface style", "Matte graphite, clean type, amber accents, and focused one-module-at-a-time editing.", 113)
    elseif module.id == "session" then
        informationCard("Session controls", "The menu is independent of Kicia and UE. Unload destroys the UI and disconnects its input listeners.", 113)
        actionCard("Hide the interface", "HIDE MENU", function() window.Visible=false end)
        actionCard("Remove the interface", "UNLOAD GUMBALL UI", function()
            local api = env.GumballControlDeck
            if api and api.Unload then api.Unload() end
        end)
    else
        informationCard("PREVIEW MODE", "These controls demonstrate the layout. Their values are saved in this session but are not connected to gameplay.", 103)
        toggleCard("Module enabled", "Demonstration on/off control.", "enabled")
        sliderCard("Intensity", "Drag to change a preview value.", "strength", 0, 100)
        choiceCard("Behavior preset", "Tap to cycle between choices.", "mode", {"Standard","Smooth","Custom"})
        toggleCard("Show indicator", "Example secondary toggle.", "indicator")
    end
end

renderBrowser = function()
    disconnectBrowser()
    clearObjects(moduleScroll)
    sectionTitle.Text = activeSection
    sectionSub.Text = activeSection == "Home" and "Welcome to the Control Deck" or "Choose a module to inspect"
    moduleScroll.CanvasPosition = Vector2.new(0,0)
    local results = sectionModules()
    if #results == 0 then
        label(moduleScroll, "No matching modules", 15, C.muted, {
            Size=UDim2.new(1,-8,0,58), TextXAlignment=Enum.TextXAlignment.Center,
        })
        return
    end
    for index, module in ipairs(results) do
        local selected = activeModule and activeModule.id == module.id
        local height = compact and 67 or 78
        local button = rounded(make("TextButton", moduleScroll, {
            Name=module.id, LayoutOrder=index, Size=UDim2.new(1,-2,0,height),
            Text="", AutoButtonColor=false, BorderSizePixel=0,
            BackgroundColor3=selected and C.raised or C.panel,
        }), 10)
        local border = stroked(button, selected and C.accent or C.line)
        if selected then markAccent(border, "Color", true) end
        local accentBar = rounded(make("Frame", button, {
            Position=UDim2.fromOffset(0,11), Size=UDim2.fromOffset(3,height-22),
            BackgroundColor3=C.accent, BorderSizePixel=0,
            Visible=selected,
        }), 3)
        if selected then markAccent(accentBar, "BackgroundColor3", true) end
        label(button, module.title, 17, C.white, {
            Position=UDim2.fromOffset(15,8), Size=UDim2.new(1,-28,0,27),
        })
        label(button, module.summary, 12, C.muted, {
            Position=UDim2.fromOffset(16,34), Size=UDim2.new(1,-30,0,20),
        })
        local status = label(button, selected and "SELECTED" or "OPEN MODULE", 10, selected and C.accent or C.faint, {
            Position=UDim2.fromOffset(16,height-22), Size=UDim2.new(1,-32,0,15),
        })
        if selected then markAccent(status, "TextColor3", true) end
        table.insert(browserConnections, button.MouseButton1Click:Connect(function()
            activeModule=module
            renderBrowser()
            renderInspector(module)
            if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
                setMobileView("inspector")
            elseif window.AbsoluteSize.X < 650 then
                setMobileView("inspector")
            end
        end))
    end
end

local function selectSection(sectionId)
    activeSection = sectionId
    searchBox.Text = ""
    local first = nil
    for _,module in ipairs(modules) do
        if module.section == sectionId then first=module; break end
    end
    activeModule = first
    refreshNavigation()
    renderBrowser()
    renderInspector(first)
    setMobileView("browser")
end
for _,section in ipairs(sections) do
    local button = navButtons[section.id].button
    track(button.MouseButton1Click:Connect(function()
        selectSection(section.id)
    end))
end
track(searchBox:GetPropertyChangedSignal("Text"):Connect(renderBrowser))
track(back.MouseButton1Click:Connect(function() setMobileView("browser") end))

applyResponsive = function()
    if not alive then return end
    local camera = workspace.CurrentCamera
    local view = camera and camera.ViewportSize or Vector2.new(1280,720)
    local width = math.min(860, math.max(290, view.X-22))
    local height = math.min(540, math.max(310, view.Y-26))
    local small = width < 650
    local navWidth = small and 56 or 78
    local browserWidth = small and width-navWidth or math.floor((width-navWidth)*.40)
    window.Size = UDim2.fromOffset(width,height)
    rail.Size = UDim2.new(0,navWidth,1,-86)
    window.RailDivider.Position = UDim2.fromOffset(navWidth-1,56)
    browser.Position = UDim2.fromOffset(navWidth,56)
    browser.Size = UDim2.new(0,browserWidth,1,-86)
    inspector.Position = UDim2.fromOffset(small and navWidth or navWidth+browserWidth,56)
    inspector.Size = UDim2.new(0,small and width-navWidth or width-navWidth-browserWidth,1,-86)
    browser.Visible = not (small and mobileView=="inspector")
    inspector.Visible = not (small and mobileView=="browser")
    back.Visible = small
    inspectEyebrow.Position = UDim2.fromOffset(small and 84 or 19,14)
    inspectEyebrow.Size = UDim2.new(1,small and -99 or -38,0,20)
    hotkeyText.Text = small and "G  /  TOGGLE" or "RIGHTSHIFT  /  TOGGLE"
    mobileToggle.Visible = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    dragHandle.Size = UDim2.new(1,-96,1,0)
    local titleSize = small and 23 or 27
    logo.TextSize = titleSize
    logo.Size = UDim2.fromOffset(small and 137 or 174,44)
    dot.Position = UDim2.fromOffset(small and 136 or 163,22)
    local descriptor = dragHandle:FindFirstChild("DeckDescriptor")
    if descriptor then descriptor.Visible = not small end
    for _,entry in pairs(navButtons) do
        entry.sub.Visible = not small
        entry.title.Position = UDim2.fromOffset(3,small and 10 or 1)
        entry.button.Size = UDim2.new(1,0,0,small and 42 or 47)
    end
end
-- The descriptor is optional on narrow screens.
for _,child in ipairs(dragHandle:GetChildren()) do
    if child:IsA("TextLabel") and child.Text == "CONTROL DECK  /  01" then
        child.Name = "DeckDescriptor"
        break
    end
end

local cameraConnection = nil
local function bindCamera()
    if cameraConnection then cameraConnection:Disconnect() end
    local camera = workspace.CurrentCamera
    if camera then
        cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyResponsive)
    end
    applyResponsive()
end
track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera))
bindCamera()

local function setVisible(value)
    window.Visible = value == true
end
track(hide.MouseButton1Click:Connect(function() setVisible(false) end))
track(mobileToggle.MouseButton1Click:Connect(function() setVisible(not window.Visible) end))
track(UserInputService.InputBegan:Connect(function(input, processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        setVisible(not window.Visible)
    elseif input.KeyCode == Enum.KeyCode.K and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
        setVisible(true)
        setMobileView("browser")
        searchBox:CaptureFocus()
    end
end))

local draggingWindow = false
local dragInput = nil
local startPosition = nil
local startMouse = nil
track(dragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingWindow = true
        dragInput = input.UserInputType == Enum.UserInputType.Touch and input or nil
        startMouse = input.Position
        startPosition = window.Position
    end
end))
track(UserInputService.InputChanged:Connect(function(input)
    if not draggingWindow then return end
    if (dragInput and input == dragInput) or (not dragInput and input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - startMouse
        window.Position = UDim2.new(startPosition.X.Scale,startPosition.X.Offset+delta.X,startPosition.Y.Scale,startPosition.Y.Offset+delta.Y)
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if (dragInput and input == dragInput) or (not dragInput and input.UserInputType == Enum.UserInputType.MouseButton1) then
        draggingWindow = false
        dragInput = nil
    end
end))

local api = {}
api.Gui = screen
api.Window = window
api.States = states
function api.SetVisible(value) setVisible(value) end
function api.GetState(id) return moduleState(id) end
function api.OnChange(callback)
    assert(type(callback)=="function", "OnChange requires a function")
    table.insert(changeListeners,callback)
end
function api.SelectSection(sectionId)
    for _,section in ipairs(sections) do
        if section.id == sectionId then selectSection(sectionId); return true end
    end
    return false
end
function api.AddModule(module)
    assert(type(module)=="table" and type(module.id)=="string" and type(module.title)=="string", "Invalid module")
    local valid = false
    for _,section in ipairs(sections) do
        if section.id == module.section then valid=true; break end
    end
    assert(valid, "Unknown section")
    for _,entry in ipairs(modules) do
        if entry.id == module.id then return false end
    end
    module.summary = module.summary or "Custom module"
    module.detail = module.detail or "Custom module settings"
    table.insert(modules,module)
    if module.section == activeSection then renderBrowser() end
    return true
end
function api.Unload()
    if not alive then return end
    alive = false
    disconnectInspector()
    disconnectBrowser()
    for _,connection in ipairs(globalConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(globalConnections)
    if cameraConnection then cameraConnection:Disconnect(); cameraConnection=nil end
    if screen.Parent then screen:Destroy() end
    if env.GumballControlDeck == api then env.GumballControlDeck = nil end
end

env.GumballControlDeck = api
selectSection("Home")
applyResponsive()
print("[Project Gumball] Control Deck UI ready. RightShift to toggle. UI-only prototype.")
