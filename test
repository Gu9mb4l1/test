applyResponsive = function()
    if not alive then return end
    local camera = workspace.CurrentCamera
    local view = camera and camera.ViewportSize or Vector2.new(1280,720)
    local width = math.min(860, math.max(290, view.X-22))
    local height = math.min(540, math.max(310, view.Y-26))
    local small = width < 650
    local browserWidth = small and width or math.floor(width*.405)
    window.Size = UDim2.fromOffset(width,height)
    browser.Position = UDim2.fromOffset(0,56)
    browser.Size = UDim2.new(0,browserWidth,1,-86)
    inspector.Position = UDim2.fromOffset(small and 0 or browserWidth,56)
    inspector.Size = UDim2.new(0,small and width or width-browserWidth,1,-86)
    browser.Visible = not (small and mobileView=="inspector")
    inspector.Visible = not (small and mobileView=="browser")
    back.Visible = small
    inspectEyebrow.Position = UDim2.fromOffset(small and 84 or 19,14)
    inspectEyebrow.Size = UDim2.new(1,small and -99 or -38,0,20)
    hotkeyText.Text = small and "G  /  TOGGLE" or "RIGHTSHIFT  /  TOGGLE"
    mobileToggle.Visible = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

    local titleWidth = small and 112 or 156
    local hideWidth = small and 49 or 68
    dragHandle.Size = UDim2.fromOffset(titleWidth,56)
    logo.TextSize = small and 22 or 27
    logo.Position = UDim2.fromOffset(small and 9 or 17,5)
    logo.Size = UDim2.fromOffset(small and 92 or 125,43)
    dot.Visible = not small
    hide.Size = UDim2.fromOffset(hideWidth,30)
    hide.Position = UDim2.new(1,small and -7 or -14,.5,0)
    hide.Text = small and "-" or "HIDE"
    tabScroll.Position = UDim2.fromOffset(titleWidth,4)
    tabScroll.Size = UDim2.new(1,-titleWidth-hideWidth-(small and 17 or 26),0,48)
end

