local function fgroup(parent,caption)
    local g=addCorner(make("Frame",parent,{Name="FeatureGroup",Size=UDim2.new(1,-4,0,0),
        AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=palette("Group"),BorderSizePixel=0}),6)
