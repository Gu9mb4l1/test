local function toggleCard(titleText, detailText, key)
    local frame = card(inspectScroll, 77)
    cardTitle(frame, titleText, detailText)
    local button = textButton(frame, "OFF", {
        AnchorPoint=Vector2.new(1,.5), Position=UDim2.new(1,-14,.5,0),
        Size=UDim2.fromOffset(61,29), TextSize=13,
    })
    local state = moduleState(activeModule.id)
    local function paint()
        local enabled = state[key] == true
        button.Text = enabled and "ON" or "OFF"
        button.TextColor3 = enabled and C.base or C.muted
        markAccent(button, "BackgroundColor3", enabled, C.raised)
    end
    track(button.MouseButton1Click:Connect(function()
        state[key] = not (state[key] == true)
        paint()
        if activeModule.id == "appearance" and key == "compact" then
            compact = state[key]
            renderBrowser()
        end
        emit(activeModule.id, key, state[key])
    end), true)
    paint()
    return frame
end
local function sliderCard(titleText, detailText, key, minValue, maxValue)
    local frame = card(inspectScroll, 100)
    cardTitle(frame, titleText, detailText)
    local state = moduleState(activeModule.id)
    local value = tonumber(state[key]) or 50
    local amount = label(frame, tostring(value), 14, C.accent, {
        Position=UDim2.new(1,-69,0,9), Size=UDim2.fromOffset(52,24),
        TextXAlignment=Enum.TextXAlignment.Right,
    })
    markAccent(amount, "TextColor3", true)
    local trackButton = rounded(textButton(frame, "", {
        Position=UDim2.new(0,15,1,-24), Size=UDim2.new(1,-30,0,9),
        BackgroundColor3=C.raised,
    }), 6)
    local fill = rounded(make("Frame", trackButton, {
        Size=UDim2.fromScale(0,1), BackgroundColor3=C.accent,
        BorderSizePixel=0,
    }), 6)
    markAccent(fill, "BackgroundColor3", true)
    local knob = rounded(make("Frame", trackButton, {
        AnchorPoint=Vector2.new(.5,.5), Position=UDim2.fromScale(0,.5),
        Size=UDim2.fromOffset(14,14), BackgroundColor3=C.white,
        BorderSizePixel=0,
    }), 7)
    local function paint()
        local fraction = math.clamp((value-minValue)/(maxValue-minValue),0,1)
        amount.Text = tostring(value)
        fill.Size = UDim2.fromScale(fraction,1)
        knob.Position = UDim2.fromScale(fraction,.5)
    end
    local dragging = false
    local touchInput = nil
    local function adjust(input)
        local width = math.max(trackButton.AbsoluteSize.X, 1)
        local fraction = math.clamp((input.Position.X-trackButton.AbsolutePosition.X)/width,0,1)
        value = math.floor(minValue + (maxValue-minValue)*fraction + .5)
        state[key] = value
        paint()
        emit(activeModule.id, key, value)
    end
    track(trackButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            touchInput = input.UserInputType == Enum.UserInputType.Touch and input or nil
            adjust(input)
        end
    end), true)
    track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement and not touchInput then
            adjust(input)
        elseif touchInput and input == touchInput then
            adjust(input)
        end
    end), true)
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and not touchInput then
            dragging = false
        elseif touchInput and input == touchInput then
            dragging = false
            touchInput = nil
        end
    end), true)
    paint()
    return frame
end
