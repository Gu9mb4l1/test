    textLabel(g,caption,15,palette("Text"),{Name="FeatureGroupTitle",Size=UDim2.new(1,0,0,24)})
    return g
end
local function fbutton(parent,label,callback,name)
    local b=addCorner(make("TextButton",parent,{Name=name or "FeatureButton",Size=UDim2.new(1,0,0,31),
        BackgroundColor3=palette("Control"),TextColor3=palette("ButtonText"),Text=label,
        Font=Enum.Font.Cartoon,TextSize=14,AutoButtonColor=true,BorderSizePixel=0}),5)
    connect(b.MouseButton1Click,callback,pageConnections)
    return b
end
local function buildControl(parent,spec)
    if spec.kind=="hint" then
        return textLabel(parent,spec.label,12,palette("Muted"),{Name="FeatureHint",Size=UDim2.new(1,0,0,34),TextWrapped=true,TextYAlignment=Enum.TextYAlignment.Top})
    end
    local key=spec.key
    if spec.kind=="button" then return fbutton(parent,spec.label,function() resetFeature(key) end) end
    if spec.kind=="toggle" then
        local b=fbutton(parent,"",function() setFeature(key,not flag(key),true) end,"FeatureToggle")
        local function redraw(value)
            b.Text=spec.label..": "..(value and "ON" or "OFF")
            b:SetAttribute("Enabled",value)
            b.BackgroundColor3=palette("Control")
            b.TextColor3=value and palette("Accent") or palette("ButtonText")
            local stroke=b:FindFirstChildOfClass("UIStroke")
            if not stroke then stroke=Instance.new("UIStroke");stroke.Parent=b end
            stroke.Color=value and palette("Accent") or palette("Border")
            stroke.Transparency=value and 0 or 1
        end
        featureUpdaters[key]=redraw
        redraw(flag(key))
        return b
    end
    if spec.kind=="choice" then
        local b=fbutton(parent,"",function()
            local choices=spec.choices
            local i=table.find(choices,flag(key)) or 0
            setFeature(key,choices[i%#choices+1],true)
        end,"FeatureChoice")
        local function redraw(value)
            b.Text=spec.label..": "..tostring(value).."  v"
        end
        featureUpdaters[key]=redraw
        redraw(flag(key))
        return b
    end
    if spec.kind=="text" then
        local label=textLabel(parent,spec.label,13,palette("Text"),{Name="FeatureLabel",Size=UDim2.new(1,0,0,20)})
        local input=addCorner(make("TextBox",parent,{Name="FeatureInput",Size=UDim2.new(1,0,0,29),
            BackgroundColor3=palette("Control"),TextColor3=palette("ButtonText"),
            Font=Enum.Font.Cartoon,TextSize=13,PlaceholderText=spec.label,
            Text=flag(key),ClearTextOnFocus=false,BorderSizePixel=0}),5)
        connect(input.FocusLost,function() setFeature(key,input.Text,true) end,pageConnections)
        featureUpdaters[key]=function(value) if not input:IsFocused() then input.Text=value end end
        return input
    end
    if spec.kind=="slider" then
        local line=make("Frame",parent,{Name="FeatureSlider",Size=UDim2.new(1,0,0,47),BackgroundTransparency=1})
        local label=textLabel(line,"",13,palette("Text"),{Name="FeatureLabel",Size=UDim2.new(1,0,0,22)})
        local track=addCorner(make("TextButton",line,{Name="FeatureSliderTrack",Text="",AutoButtonColor=false,
            Position=UDim2.fromOffset(2,31),Size=UDim2.new(1,-4,0,7),BackgroundColor3=palette("Control"),BorderSizePixel=0}),5)
        local fill=addCorner(make("Frame",track,{Name="FeatureSliderFill",Size=UDim2.fromScale(0,1),
            BackgroundColor3=palette("Accent"),BorderSizePixel=0}),5)
        local draggingSlider=false
        local function redraw(value)
            label.Text=spec.label..": "..tostring(value)
            fill.Size=UDim2.fromScale(math.clamp((value-spec.min)/(spec.max-spec.min),0,1),1)
        end
        local function move(input)
            local width=math.max(1,track.AbsoluteSize.X)
            local frac=math.clamp((input.Position.X-track.AbsolutePosition.X)/width,0,1)
            setFeature(key,spec.min+frac*(spec.max-spec.min),true)
        end
        connect(track.InputBegan,function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
                draggingSlider=true;move(input)
            end
        end,pageConnections)
        connect(UserInputService.InputChanged,function(input)
            if draggingSlider and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
                move(input)
            end
        end,pageConnections)
        connect(UserInputService.InputEnded,function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
                draggingSlider=false
            end
        end,pageConnections)
        featureUpdaters[key]=redraw
        redraw(flag(key))
        return line
    end
end

local function pageFeatureBuilder(tab,category)
    local groupDefinitions=FeaturePages[tab.." / "..category]
    return function(left,right)
        table.clear(featureUpdaters)
        for index,g in ipairs(groupDefinitions) do
            local parent=(index%2==1) and left or right
            local card=fgroup(parent,g.title)
            for _,item in ipairs(g.controls) do buildControl(card,item) end
        end
        paintTheme()
        return function() table.clear(featureUpdaters) end
    end
end

for page,groups in pairs(FeaturePages) do
    for _,g in ipairs(groups) do
        for _,spec in ipairs(g.controls) do
            if spec.key~="" and spec.kind~="button" and spec.kind~="hint" then
                if FeatureDefinitions[spec.key] then warn("Duplicate feature key: "..spec.key) end
                FeatureDefinitions[spec.key]=spec
                FeatureValues[spec.key]=spec.default
            end
        end
    end
end
for key,spec in pairs(FeatureDefinitions) do
