local function setVisible(value)
    window.Visible = value == true
end
track(hide.MouseButton1Click:Connect(function() setVisible(false) end))
track(mobileToggle.MouseButton1Click:Connect(function() setVisible(not window.Visible) end))
track(UserInputService.InputBegan:Connect(function(input, processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        setVisible(not window.Visible)
    elseif input.KeyCode == Enum.KeyCode.K and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
        setVisible(true)
        setMobileView("browser")
        searchBox:CaptureFocus()
    end
end))

local draggingWindow = false
local dragInput = nil
local startPosition = nil
local startMouse = nil
track(dragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingWindow = true
        dragInput = input.UserInputType == Enum.UserInputType.Touch and input or nil
        startMouse = input.Position
        startPosition = window.Position
    end
end))
track(UserInputService.InputChanged:Connect(function(input)
    if not draggingWindow then return end
    if (dragInput and input == dragInput) or (not dragInput and input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - startMouse
        window.Position = UDim2.new(startPosition.X.Scale,startPosition.X.Offset+delta.X,startPosition.Y.Scale,startPosition.Y.Offset+delta.Y)
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if (dragInput and input == dragInput) or (not dragInput and input.UserInputType == Enum.UserInputType.MouseButton1) then
        draggingWindow = false
        dragInput = nil
    end
end))

local api = {}
api.Gui = screen
api.Window = window
api.States = states
function api.SetVisible(value)
    if not alive then return end
    setVisible(value)
end
function api.GetState(id)
    if not alive then return nil end
    return moduleState(id)
end
function api.OnChange(callback)
    assert(type(callback)=="function", "OnChange requires a function")
    if not alive then return false end
    table.insert(changeListeners,callback)
    return true
end
function api.SelectSection(sectionId)
    if not alive then return false end
    for _,section in ipairs(sections) do
        if section.id == sectionId then selectSection(sectionId); return true end
    end
    return false
end
function api.AddModule(module)
    if not alive then return false end
    assert(type(module)=="table" and type(module.id)=="string" and type(module.title)=="string", "Invalid module")
    local valid = false
    for _,section in ipairs(sections) do
        if section.id == module.section then valid=true; break end
    end
    assert(valid, "Unknown section")
    for _,entry in ipairs(modules) do
        if entry.id == module.id then return false end
    end
    module.summary = module.summary or "Custom module"
    module.detail = module.detail or "Custom module settings"
    table.insert(modules,module)
    if module.section == activeSection then renderBrowser() end
    return true
end
-- Feature code added later can register its own connections and cleanup here.
-- This lets Unload Gumball stop future feature loops as well as the UI.
function api.RegisterCleanup(callback)
    assert(type(callback)=="function", "RegisterCleanup requires a function")
    if not alive then pcall(callback); return false end
    table.insert(cleanupHandlers,callback)
    return true
end
function api.TrackConnection(connection)
    if not alive then
        pcall(function() connection:Disconnect() end)
        return nil
    end
    table.insert(globalConnections,connection)
    return connection
end
function api.TrackTask(thread)
    if not alive then
        pcall(task.cancel, thread)
        return nil
    end
    table.insert(cleanupHandlers,function() pcall(task.cancel, thread) end)
    return thread
end
function api.Unload()
    if not alive then return end
    alive = false
    toastGeneration += 1
    if toastTask then pcall(task.cancel,toastTask); toastTask=nil end
    if toastComplete then pcall(function() toastComplete:Disconnect() end); toastComplete=nil end
    if toastTween then pcall(function() toastTween:Cancel() end); toastTween=nil end
    for index=#cleanupHandlers,1,-1 do
        pcall(cleanupHandlers[index])
        cleanupHandlers[index]=nil
    end
    disconnectInspector()
    disconnectBrowser()
    for _,connection in ipairs(globalConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(globalConnections)
    table.clear(changeListeners)
    if cameraConnection then pcall(function() cameraConnection:Disconnect() end); cameraConnection=nil end
    if screen.Parent then screen:Destroy() end
    if env.GumballControlDeck == api then env.GumballControlDeck = nil end
    print("[Project Gumball] Unloaded completely.")
end

