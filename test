-- Gumball config profiles. Registered settings are serialized as JSON-safe values.
-- Other feature pages can register settings using GumballMenu.RegisterSetting(id, getter, setter).
local HttpService = game:GetService("HttpService")
local ROOT_DIR = "Project Gumball"
local RIVALS_DIR = ROOT_DIR.."/rivals"
local CONFIG_DIR = RIVALS_DIR.."/config"
local THEME_DIR = RIVALS_DIR.."/theme"
local STATE_PATH = RIVALS_DIR.."/settings.json"
local registeredSettings = {}
local cfgState = {AutoSave=false, AutoLoad=false, AutoSaveProfile="", AutoLoadProfile=""}
local cfgSelected = ""
local cfgLastSaved = ""
local cfgLoading = false
local cfgRevision = 0
local pendingAutoSave = false
local pendingAutoLoadValues = nil
local cfgNotice = function(message) print("[Gumball Config] " .. tostring(message)) end
local function validName(name)
    if type(name) ~= "string" then return nil end
    name = name:match("^%s*(.-)%s*$")
    if #name < 1 or #name > 48 or not name:match("^[%w_%- ]+$") then return nil end
    return name
end
local function hasFiles()
    return type(writefile)=="function" and type(readfile)=="function" and type(isfile)=="function" and type(makefolder)=="function"
end
local function ensureFolders()
    if not hasFiles() then return false,"Executor file functions are unavailable" end
    for _,folder in ipairs({ROOT_DIR,RIVALS_DIR,CONFIG_DIR,THEME_DIR}) do
        local ok,err=pcall(function()
            if type(isfolder)~="function" or not isfolder(folder) then makefolder(folder) end
        end)
        if not ok and (type(isfolder)~="function" or not isfolder(folder)) then return false,tostring(err) end
    end
    return true
end
local function cfgPath(name) return CONFIG_DIR.."/"..name..".json" end
local function readJSON(path)
    local ok,value=pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if ok and type(value)=="table" then return value end
    return nil,"Could not read JSON"
end
local function writeJSON(path,value)
    local ok,err=pcall(function() writefile(path,HttpService:JSONEncode(value)) end)
    return ok,ok and nil or tostring(err)
end
local function captureConfig()
    local values={}
    for id,handler in pairs(registeredSettings) do
        local ok,value=pcall(handler.get)
        if ok and value~=nil then
            local serial=pcall(function() HttpService:JSONEncode(value) end)
            if serial then values[id]=value end
        end
    end
    return {Format="GumballConfig",Version=1,Values=values}
end
local function applyConfig(data)
    if type(data)~="table" or data.Format~="GumballConfig" or type(data.Values)~="table" then
        return false,"Invalid Gumball config format"
    end
    cfgLoading=true
    pendingAutoLoadValues=data.Values
    local failed=0
    for id,value in pairs(data.Values) do
        local handler=registeredSettings[id]
        if handler then
            local ok=pcall(handler.set,value)
            if not ok then failed+=1 end
        end
    end
    cfgLoading=false
    return failed==0,failed==0 and nil or (tostring(failed).." settings failed to apply")
end
local function listConfigs()
    local names={}
    if type(listfiles)=="function" then
        local ok,files=pcall(listfiles,CONFIG_DIR)
        if ok and type(files)=="table" then
            for _,path in ipairs(files) do
                local name=path:gsub("\\","/"):match("([^/]+)%.json$")
                if name and validName(name) then table.insert(names,name) end
            end
        end
    end
    table.sort(names)
    return names
end
local function saveConfig(name,overwrite)
    name=validName(name)
    if not name then return false,"Enter a name (letters, numbers, spaces, - or _)" end
    local ok,err=ensureFolders();if not ok then return false,err end
    if isfile(cfgPath(name)) and not overwrite then return false,"Config exists. Use Overwrite." end
    return writeJSON(cfgPath(name),captureConfig())
end
local function loadConfig(name)
    name=validName(name)
    if not name then return false,"Select a config" end
    if not hasFiles() or not isfile(cfgPath(name)) then return false,"Config not found" end
    local data,err=readJSON(cfgPath(name));if not data then return false,err end
    return applyConfig(data)
end
local function deleteConfig(name)
    name=validName(name)
    if not name or not hasFiles() or not isfile(cfgPath(name)) then return false,"Config not found" end
    if type(delfile)~="function" then return false,"Executor does not support delfile" end
    local ok,err=pcall(delfile,cfgPath(name))
    if ok then
        if cfgState.AutoSaveProfile==name then cfgState.AutoSaveProfile="";cfgState.AutoSave=false end
        if cfgState.AutoLoadProfile==name then cfgState.AutoLoadProfile="";cfgState.AutoLoad=false end
        if cfgSelected==name then cfgSelected="" end
    end
    return ok,ok and nil or tostring(err)
end
local function importConfig(name,json)
    name=validName(name)
    if not name then return false,"Enter a name for the imported config" end
    local ok,data=pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data)~="table" or data.Format~="GumballConfig" or type(data.Values)~="table" or data.Version~=1 then
        return false,"Not a compatible Project Gumball config code"
    end
    local ready,err=ensureFolders();if not ready then return false,err end
    if isfile(cfgPath(name)) then return false,"That config already exists" end
    return writeJSON(cfgPath(name),data)
end
local function exportConfig(name)
    name=validName(name)
    if not name or not hasFiles() or not isfile(cfgPath(name)) then return nil,"Select a saved config" end
    local data,err=readJSON(cfgPath(name))
    if not data then return nil,err end
    return HttpService:JSONEncode(data)
end
local function persistState()
    if not hasFiles() then return end
    local ok=ensureFolders()
    if ok then writeJSON(STATE_PATH,cfgState) end
end
local function loadState()
    if not hasFiles() then return end
    local ok=ensureFolders()
    if not ok or not isfile(STATE_PATH) then return end
    local state=readJSON(STATE_PATH)
    if type(state)=="table" then
        for _,key in ipairs({"AutoSave","AutoLoad"}) do
            if type(state[key])=="boolean" then cfgState[key]=state[key] end
        end
        for _,key in ipairs({"AutoSaveProfile","AutoLoadProfile"}) do
            if type(state[key])=="string" then cfgState[key]=validName(state[key]) or "" end
        end
    end
end
loadState()

-- Independent theme palette. Theme files are deliberately separate from gameplay configs.
local themeDefaults = {
    Background="090B10", Header="0A0C11", Border="2D313A", Divider="1E222B",
    Text="F3F5F9", Muted="91959F", TabText="91959F", ActiveTab="F3F5F9",
    TabUnderline="F3F5F9", CategoryText="91959F", ActiveCategory="F3F5F9",
    CategoryUnderline="F3F5F9", Sidebar="090B10", Panel="0A0C11",
    Group="0A0C11", Control="151921", ButtonText="F3F5F9",
    Accent="F3F5F9", Danger="D15454",
}
local themeValues = table.clone(themeDefaults)
local themeName = "Default"
local THEME_ACTIVE_PATH = THEME_DIR.."/active.json"
local function hexColor(hex)
    if type(hex)~="string" then return nil end
    hex=hex:gsub("#",""):upper()
    if #hex~=6 or not hex:match("^%x%x%x%x%x%x$") then return nil end
    return Color3.fromRGB(tonumber(hex:sub(1,2),16),tonumber(hex:sub(3,4),16),tonumber(hex:sub(5,6),16)),hex
end
local function palette(key)
    return (hexColor(themeValues[key] or themeDefaults[key])) or Colors.White
end
local function themePath(name) return THEME_DIR.."/"..name..".json" end
local function themeList()
    local result={}
    if type(listfiles)=="function" then
        local ok,files=pcall(listfiles,THEME_DIR)
        if ok and type(files)=="table" then
            for _,path in ipairs(files) do
                local n=path:gsub("\\","/"):match("([^/]+)%.json$")
                if n and n~="active" and validName(n) then table.insert(result,n) end
            end
        end
    end
    table.sort(result)
    return result
end
local function themeDocument()
    return {Format="GumballTheme",Version=1,Colors=table.clone(themeValues)}
end
local function applyThemeData(data)
    if type(data)~="table" or data.Format~="GumballTheme" or data.Version~=1 or type(data.Colors)~="table" then
        return false,"Invalid Gumball theme"
    end
    for key in pairs(themeDefaults) do
        local _,hex=hexColor(data.Colors[key])
        if hex then themeValues[key]=hex end
    end
    return true
end
local function saveTheme(name,overwrite)
    name=validName(name)
    if not name then return false,"Invalid theme name" end
    local ok,err=ensureFolders();if not ok then return false,err end
    if isfile(themePath(name)) and not overwrite then return false,"Theme already exists" end
    return writeJSON(themePath(name),themeDocument())
end
local function loadTheme(name)
    name=validName(name)
    if not name or not hasFiles() or not isfile(themePath(name)) then return false,"Theme not found" end
    local data,err=readJSON(themePath(name));if not data then return false,err end
    local ok,why=applyThemeData(data)
    if ok then themeName=name end
    return ok,why
end
local function persistTheme()
    if not hasFiles() then return end
    local ok=ensureFolders()
    if ok then writeJSON(THEME_ACTIVE_PATH,{Name=themeName,Theme=themeDocument()}) end
end
local function restoreTheme()
    if not hasFiles() then return end
    local ok=ensureFolders()
    if not ok or not isfile(THEME_ACTIVE_PATH) then return end
    local data=readJSON(THEME_ACTIVE_PATH)
    if type(data)=="table" then
        if type(data.Name)=="string" then themeName=validName(data.Name) or "Default" end
        applyThemeData(data.Theme)
    end
end
restoreTheme()

-- Repaint existing UI without rebuilding it while typing into a theme field.
local function paintTheme()
    if not alive then return end
    Colors.Background=palette("Background")
    Colors.Header=palette("Header")
    Colors.Border=palette("Border")
    Colors.Divider=palette("Divider")
    Colors.White=palette("Text")
    Colors.Muted=palette("Muted")
    Colors.Hover=palette("Control")
    Colors.Danger=palette("Danger")
    window.BackgroundColor3=palette("Background")
    header.BackgroundColor3=palette("Header")
    content.BackgroundColor3=palette("Panel")
    sidebar.BackgroundTransparency=0
    sidebar.BackgroundColor3=palette("Sidebar")
    mobileToggle.BackgroundColor3=palette("Header")
    mobileToggle.TextColor3=palette("Text")
    for _,obj in ipairs(screenGui:GetDescendants()) do
        if obj:IsA("UIStroke") then
            if obj.Parent==window or obj.Parent==mobileToggle then obj.Color=palette("Border")
            elseif obj.Parent:IsA("Frame") and obj.Parent.Name=="ThemeGroup" then obj.Color=palette("Border")
            elseif obj.Parent:IsA("TextButton") and obj.Parent.Name=="ThemeSwatch" then obj.Color=palette("Border")
            elseif obj.Parent:IsA("Frame") and obj.Parent.Name=="FeatureGroup" then obj.Color=palette("Border")
            elseif obj.Parent:IsA("TextButton") and obj.Parent.Name=="FeatureToggle" then
                obj.Color=palette(obj.Parent:GetAttribute("Enabled") and "Accent" or "Border") end
        elseif obj:IsA("UIGradient") and obj.Parent==content then
            obj.Color=ColorSequence.new(palette("Panel"))
        elseif obj:IsA("GuiObject") then
            local n=obj.Name
            if n=="HeaderDivider" or n=="BlueDivider" or n=="CategoryHeadingDivider" then obj.BackgroundColor3=palette("Divider")
            elseif n=="SquareHeaderBottom" then obj.BackgroundColor3=palette("Header")
            elseif n=="ActiveUnderline" then obj.BackgroundColor3=palette("TabUnderline")
            elseif n=="ActiveCategoryUnderline" then obj.BackgroundColor3=palette("CategoryUnderline")
            elseif n=="ThemeGroup" then obj.BackgroundColor3=palette("Group")
            elseif n=="ThemeInput" or n=="ThemeButton" then obj.BackgroundColor3=palette("Control")
            elseif n=="FeatureGroup" then obj.BackgroundColor3=palette("Group")
            elseif n=="FeatureButton" or n=="FeatureInput" or n=="FeatureChoice" or n=="FeatureSliderTrack" then obj.BackgroundColor3=palette("Control")
            elseif n=="FeatureSliderFill" then obj.BackgroundColor3=palette("Accent")
            elseif n=="FeatureToggle" then obj.BackgroundColor3=palette("Control")
            elseif n=="ThemeSwatch" then
                local k=obj:GetAttribute("ThemeKey")
                if k and themeDefaults[k] then obj.BackgroundColor3=palette(k) end
            end
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                if n=="Title" or n=="CurrentCategoryTitle" then obj.TextColor3=palette("Text")
                elseif n=="CategoryName" then
                    local item=obj.Parent
                    local selected=item and item:FindFirstChild("ActiveCategoryUnderline") and item.ActiveCategoryUnderline.Visible
                    obj.TextColor3=palette(selected and "ActiveCategory" or "CategoryText")
                elseif n=="Label" and obj.Parent and obj.Parent.Name:match("^Tab_") then
                    local underline=obj.Parent:FindFirstChild("ActiveUnderline")
                    obj.TextColor3=palette(underline and underline.Visible and "ActiveTab" or "TabText")
                elseif n=="ThemeButton" or n=="ThemeInput" then obj.TextColor3=palette("ButtonText")
                elseif n=="ThemeFieldLabel" then obj.TextColor3=palette("Text")
                elseif n=="FeatureLabel" or n=="FeatureGroupTitle" then obj.TextColor3=palette("Text")
                elseif n=="FeatureHint" then obj.TextColor3=palette("Muted")
                elseif n=="FeatureToggle" then obj.TextColor3=palette(obj:GetAttribute("Enabled") and "Accent" or "ButtonText")
                elseif n=="FeatureButton" or n=="FeatureChoice" or n=="FeatureInput" then obj.TextColor3=palette("ButtonText") end
            end
        end
    end
end
local function setThemeColor(key,hex)
    if not themeDefaults[key] then return false end
    local _,normalized=hexColor(hex)
    if not normalized then return false end
    themeValues[key]=normalized
    paintTheme() -- preview only; saved themes change only on explicit save
    return true
end

-- Grouped theme editor with individual colors and theme file management.
local function themePage(left,right)
    local function group(parent,title)
        local frame=addCorner(make("Frame",parent,{Name="ThemeGroup",Size=UDim2.new(1,-4,0,0),
            AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=palette("Group"),BorderSizePixel=0}),6)
        make("UIStroke",frame,{Color=palette("Border"),Thickness=1})
        make("UIPadding",frame,{PaddingTop=UDim.new(0,9),PaddingBottom=UDim.new(0,9),PaddingLeft=UDim.new(0,9),PaddingRight=UDim.new(0,9)})
        make("UIListLayout",frame,{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder})
        textLabel(frame,title,16,palette("Text"),{Size=UDim2.new(1,0,0,24)})
        return frame
    end
    local notice=textLabel(right,"Theme: "..themeName,13,palette("Muted"),{Size=UDim2.new(1,-4,0,30),TextWrapped=true})
    local function message(value) notice.Text=tostring(value) end
    local inputs={}
    local swatches={}
    local popup=nil
    local function closePicker()
        if popup then popup:Destroy();popup=nil end
    end
    local function sync()
        for key,input in pairs(inputs) do
            if input then input.Text="#"..themeValues[key] end
            if swatches[key] then swatches[key].BackgroundColor3=palette(key) end
        end
        paintTheme()
    end
    local function button(parent,label,callback)
        local b=addCorner(make("TextButton",parent,{Name="ThemeButton",Size=UDim2.new(1,0,0,30),
            Text=label,Font=Enum.Font.Cartoon,TextSize=14,TextColor3=palette("ButtonText"),
            BackgroundColor3=palette("Control"),BorderSizePixel=0}),5)
        connect(b.MouseButton1Click,callback,pageConnections)
        return b
    end
    local function openPicker(key,label)
